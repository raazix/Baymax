# The app creates its schema on first launch; keep the real connection URL in ignored .env.
# Optional backend authentication. Set in the shell or the ignored backend .env.
# LINEGUARD_API_TOKEN=replace-with-a-secret
# Neon PostgreSQL connection; put the actual URL in the ignored root .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
